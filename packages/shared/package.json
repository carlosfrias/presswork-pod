{
  "name": "@presswork/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    },
    "./db": {
      "import": "./dist/db.js",
      "types": "./src/db.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./src/config.ts"
    },
    "./logger": {
      "import": "./dist/logger.js",
      "types": "./src/logger.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./src/types.ts"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "types": "./src/constants.ts"
    },
    "./etsy-tokens": {
      "import": "./dist/etsy-tokens.js",
      "types": "./src/etsy-tokens.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "@types/ws": "^8.18.1",
    "async-retry": "^1.3.3",
    "bottleneck": "^2.19.5",
    "pino": "^9.0.0",
    "ws": "^8.20.1",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.8",
    "@types/node": "^25.8.0",
    "msw": "^2.0.0",
    "vitest": "^1.0.0"
  }
}
