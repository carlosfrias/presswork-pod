# Anthropic
ANTHROPIC_API_KEY=

# Etsy
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHIPPING_PROFILE_ID=
# Numeric Etsy production-partner ID for Printify.
# Register Printify in Etsy Shop Manager → Production Partners, then paste the ID here.
# Listings will hard-fail validation if this is missing or zero.
ETSY_PRODUCTION_PARTNER_ID=
# Required on all physical listings since Etsy's Sep 30 2025 Processing Profiles migration.
# Run once: npx ts-node scripts/get_etsy_readiness_state.ts — paste the returned ID here.
ETSY_READINESS_STATE_ID=

# fal.ai
FAL_KEY=

# Printify — used by the Listing agent for product create + publish.
# The Ledger agent no longer calls Printify (Etsy's native integration handles fulfillment).
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alerts
RESEND_API_KEY=
ALERT_EMAIL=
SLACK_WEBHOOK_URL=

# Runtime
NODE_ENV=development
LOG_LEVEL=info
# Scout: include Etsy listing thumbnails in the Claude analyzer call.
# Off by default. When on, adds ~3-5× per-run token cost (~$0.16-0.25/nightly run).
SCOUT_VISION_ENABLED=false

# Background-removal backend for the Design agent.
# "birefnet" → fal.ai birefnet v2 (default, matting-quality, transparent PNG, ~$0.02-0.05/image).
# "rembg"    → legacy local U²-Net + matte cleanup + optional screen_print strip.
BACKGROUND_REMOVAL_MODE=birefnet
# Emergency kill-switch for birefnet specifically. When false, the design agent
# falls back to rembg even if BACKGROUND_REMOVAL_MODE=birefnet.
BIREFNET_ENABLED=true

# Dashboard (packages/dashboard) — Next.js control plane on Vercel.
# Comma-separated allowlist of owner emails permitted to sign in via magic link.
# Anyone not on this list is rejected at the auth callback.
DASHBOARD_ALLOWED_EMAILS=
# Public Supabase keys used by the dashboard browser client (Realtime, auth callback).
# Anon key only — never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# When true AND the dashboard is running on a machine that has the repo
# checked out, the "Run [agent]" buttons spawn the agent as a local
# subprocess (Python or npm). When false (default, and on Vercel deploys),
# the buttons show the CLI command to copy instead. Never set true in a
# cloud deploy — the spawn would fail with no Python/npm available.
DASHBOARD_LOCAL_TRIGGERS_ENABLED=false
