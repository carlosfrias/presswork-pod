# Anthropic
ANTHROPIC_API_KEY=

# Etsy
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHIPPING_PROFILE_ID=
# Numeric Etsy production-partner ID for Printify.
# Register Printify in Etsy Shop Manager → Production Partners, then paste the ID here.
# Listings will hard-fail validation if this is missing or zero.
ETSY_PRODUCTION_PARTNER_ID=

# fal.ai
FAL_KEY=

# Printify
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Webhook (optional — set both to enable webhook-driven order updates)
# PRINTIFY_WEBHOOK_BASE_URL= # e.g. https://yourapp.railway.app
# PRINTIFY_WEBHOOK_SECRET=   # 32+ byte random string; run: openssl rand -hex 32

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alerts
RESEND_API_KEY=
ALERT_EMAIL=
SLACK_WEBHOOK_URL=

# Runtime
NODE_ENV=development
LOG_LEVEL=info
HUMAN_REVIEW_ENABLED=true
PORT=3000
